(* Ejemplo YALex — expresiones aritmeticas *)

let digit  = ['0'-'9']
let letter = ['a'-'z''A'-'Z']

rule tokens =
  | digit+                { INT }
  | digit+'.'digit+       { FLOAT }
  | letter(letter|digit)* { ID }
  | '+'  { PLUS }
  | '-'  { MINUS }
  | '*'  { TIMES }
  | '/'  { DIVIDE }
  | '('  { LPAREN }
  | ')'  { RPAREN }
  | '='  { EQUALS }
  | ' '  { (* ignorar *) }